<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="es_CL"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}" default="Catálogo"/> · MercadoNexo</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/estilos.css">
</head>
<body>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="${pageContext.request.contextPath}/">Mercado<span>Nexo</span></a>
        <nav class="nav">
            <a href="${pageContext.request.contextPath}/inicio" class="${pagina == 'inicio' ? 'activo' : ''}">Inicio</a>
            <a href="${pageContext.request.contextPath}/productos" class="${pagina == 'productos' ? 'activo' : ''}">Productos</a>
            <a href="${pageContext.request.contextPath}/categorias" class="${pagina == 'categorias' ? 'activo' : ''}">Categorías</a>
            <a href="${pageContext.request.contextPath}/productos?accion=consultas" class="${pagina == 'consultas' ? 'activo' : ''}">Consultas JPQL</a>
        </nav>
    </div>
</header>
<main class="contenedor">
<c:if test="${not empty sessionScope.mensaje}">
    <div class="alerta ${sessionScope.tipoMensaje == 'error' ? 'error' : 'ok'}">
        <c:out value="${sessionScope.mensaje}"/>
    </div>
    <c:remove var="mensaje" scope="session"/>
    <c:remove var="tipoMensaje" scope="session"/>
</c:if>
